{
  "name": "trackfree-me",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-policy explainer and data-rights guide.",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build:css": "tailwindcss -i ./src/styles.css -o ./style.css --minify",
    "build": "npm run validate:data && npm run build:css",
    "validate:data": "node scripts/validate-data.js",
    "db:migrate": "node scripts/migrate-db.js",
    "test": "node --test"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
